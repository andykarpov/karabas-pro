# A gitignore for Altera Quartus II that tries to ignore almost all of the
# automatically Quartus-generated files. This primarily leaves the project,
# settings, source, and constraint files to be added. The files ignored do not
# include the bulk of the MegaFunction Wizard generated files which enables
# a cloned repository to be used (usually) immediately without regenerating
# Altera IP blocks.

# Need to keep all HDL files and timing constraint files
# *.vhd
# *.v
# *.sdc

# ignore Quartus II generated folders
*_sim
db
greybox_tmp
incremental_db
simulation
testbench
timing

# ignore Quartus II generated files
*_generation_script*
*_inst.vhd
*.bak
*.cmp
*.done
*.eqn
#*.hex
#*.html
*.jdi
#*.jpg
#*.mif
*.pin
*.ptf.*
*.qar
*.qarlog
*.qws
*.rpt
*.smsg
#*.sof
*.sopc_builder
*.summary
#*.tcl
#*.txt # Explicitly add any text files used
*~
*example*
*sopc_*
PLLJ_PLLSPE_INFO.txt
messages.mif

# KiCAD
#*-cache.lib
*.*-bak
#*-info-cache
bom
pcb/rev*/gerbers
*-sch.pdf
*-top.pdf
*-bot.pdf
*-bom.pdf
*.csv
karabas-pro-*-backups/
# Gtkwave
*.ghw
*.cf


# Quartus tarball for docker/quartus13 (private, see docker/quartus13/README.md)
docker/quartus13/*.tar.xz
docker/quartus13/*.tar.xz.sha256

# Local build outputs (firmware/src/build*.sh), packed by scripts/package_release.sh
firmware/build/

# Timing reports from scripts/timing/report.sh
firmware/src/fpga/profi/syn/*/timing_*.txt
firmware/src/fpga/profi/syn/*/timing_sta.log
firmware/src/fpga/profi/syn/*/build.log

# repository scripts (the Quartus rules above ignore any "timing" directory)
!scripts/timing/
